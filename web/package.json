{
  "name": "pensionbridge-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:assign": "tsx --env-file=.env.local scripts/seed.ts assign",
    "db:unassign": "tsx --env-file=.env.local scripts/seed.ts unassign",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "tsx --env-file=.env.local scripts/e2e.ts",
    "db:reset": "tsx --env-file=.env.local scripts/seed.ts reset"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
